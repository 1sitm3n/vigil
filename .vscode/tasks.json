{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure (Debug)",
            "type": "shell",
            "command": "cmake",
            "args": ["-S", ".", "-B", "build", "-DCMAKE_BUILD_TYPE=Debug", "-G", "Ninja"],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Configure (Release)",
            "type": "shell",
            "command": "cmake",
            "args": ["-S", ".", "-B", "build", "-DCMAKE_BUILD_TYPE=Release", "-G", "Ninja"],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Build",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "build", "-j"],
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Run",
            "type": "shell",
            "command": "${workspaceFolder}/build/vigil",
            "group": { "kind": "test", "isDefault": true },
            "dependsOn": "Build",
            "problemMatcher": []
        },
        {
            "label": "Clean",
            "type": "shell",
            "command": "rm",
            "args": ["-rf", "build"],
            "problemMatcher": []
        }
    ]
}
